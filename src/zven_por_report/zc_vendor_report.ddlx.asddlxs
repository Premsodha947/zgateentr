//@Metadata.layer: layer
@Metadata.layer: #PARTNER
  @UI.headerInfo: { typeName: 'Gate Entry', typeNamePlural: 'Gate Entry',
                    title: { type:#STANDARD, label:'Gate Entry', value:'gate_entry_id' } }
annotate entity ZC_VENDOR_REPORT
    with 
{
@UI.facet: [
    { id:'HeaderData', purpose:#STANDARD, type:#IDENTIFICATION_REFERENCE, label:'Header Data', position:10 } ]
    
    @EndUserText.label: 'Gate Entry ID'       
    @UI: { lineItem: [{ position:10, label:'Gate Entry ID' }],
        identification: [{ position: 10, label: 'Gate Entry ID' }],
        selectionField:[ { position: 10 } ]
     }
    gate_entry_id;
    
    @EndUserText.label: 'Invoice No'
    @UI: { lineItem: [{ position:20, label:'Invoice No' }],
        identification: [{ position: 20, label: 'Invoice No' }],
        selectionField:[ { position: 30 } ]
     }
    invoice_no;
    
    @UI: { lineItem: [{ position:30, label:'System Date' }],
        identification: [{ position: 30, label: 'System Date' }]
     }
    system_date;
    
    
    @UI: { lineItem: [{ position:40, label:'Invoice Date' }],
        identification: [{ position: 40, label: 'Invoice Date' }],
        selectionField:[ { position: 90 } ]
     }
    invoice_date;
    
    @EndUserText.label: 'Purchase Order'
    @UI: { lineItem: [{ position:50, label:'Purchasing Order' }],
        identification: [{ position: 50, label: 'Purchasing Order' }],
        selectionField:[ { position: 70 } ]
     }
    ponumber;
    
    @UI: { lineItem: [{ position:60, label:'Challan No' }],
        identification: [{ position: 60, label: 'Challan No' }]
     }
    zchalan;
    
    @UI: { lineItem: [{ position:70, label:'Vendor' }],
        identification: [{ position: 70, label: 'Vendor' }],
        selectionField:[ { position: 70 } ]
     }
    vendor;
    @UI: { lineItem: [{ position:75, label:'Vendor Name' }],
        identification: [{ position: 75, label: 'Vendor Name' }]
//        selectionField:[ { position: 70 } ]
     }
    SupplierName;
    
    @UI: { lineItem: [{ position:80, label:'Status' }],
        identification: [{ position: 80, label: 'Status' }]
     }
    status; 
    @UI: { lineItem: [{ position: 90, label: 'Plant' }],
        identification: [{ position: 90, label: 'Plant' }],
        selectionField:[ { position: 20 } ]
     }
    plant;
    @UI.lineItem: [{ position: 100, label: 'Plant Name' }]
    PlantName;  
    
    @EndUserText.label: 'Inward Type'        
    @UI: { lineItem: [{ position:110, label:'Inward Type' }],
        identification: [{ position: 110, label: 'Inward Type' }],
    selectionField:[ { position: 60 } ] }
    inwardtype; 
    
    @UI: { lineItem: [{ position:120, label:'Fiscal Year' }],
        identification: [{ position: 120, label: 'Fiscal Year' }],
    selectionField:[ { position: 50 } ] } 
    fiscalyear; 
    @UI.lineItem: [{ position: 130, label: 'System Time' }]
    system_time;
    @UI.lineItem: [{ position: 140, label: 'LR Date' }]
    lrdate;
    @UI.lineItem: [{ position: 150, label: 'LR Number' }]
    lrnumber;
    @UI.lineItem: [{ position: 160, label: 'Eway No' }]
    ewayno;
    @UI.lineItem: [{ position: 170, label: 'Eway Bill Date' }]
    ewaydate;
    @UI.lineItem: [{ position: 180, label: 'Vehicle No' }]
    vehicleno;
    @UI.lineItem: [{ position: 190, label: 'TransPorter' }]
    transporter;
    @UI.lineItem: [{ position: 200, label: 'Remarks' }]
    remarks         ;
    @EndUserText.label: 'Department' 
    @UI: { lineItem: [{ position: 210, label: 'Department' }],
        identification: [{ position: 210, label: 'Department' }],
        selectionField:[ { position: 40 } ]
     }
    department ;
    @UI.lineItem: [{ position: 220, label: 'Department Description' }]
    purchase_grpdesc ;
    @UI.lineItem: [{ position: 230, label: 'Vehicle Type' }]
    vehicletype     ;
    @UI.lineItem: [{ position: 240, label: 'Item No' }]
    itemno ;
    @UI: { lineItem: [{ position: 250, label: 'Material' }],
        identification: [{ position: 250, label: 'Material' }],
        selectionField:[ { position: 80 } ]
     }
    material  ;
    @UI.lineItem: [{ position: 260, label: 'Material Description' }]
    materialdesc  ;
    @UI.lineItem: [{ position: 270, label: 'Quantity' }]
    quantity  ;
    @UI.lineItem: [{ position: 280, label: 'UOM' }]
    uom  ;
    @UI.lineItem: [{ position: 290, label: 'Posted Quantity' }]
    postedquantity  ;
    @UI.lineItem: [{ position: 300, label: 'Remaining Quantity' }]
    remaining_qty  ;
    @UI.lineItem: [{ position: 310, label: 'Transporter Code' }]
    transporter_code  ;
    @UI.lineItem: [{ position: 320, label: 'Cancel Gate Entry' }]
    cancelgateentry  ;
    @UI.lineItem: [{ position: 330, label: 'Canceled By User' }]
    deleteduserid  ;
    @UI.lineItem: [{ position: 340, label: 'Canceled By User Name' }]
    deletedusername  ;
    @UI.lineItem: [{ position: 350, label: 'Cancelation Date' }]
    deleteddate  ;
    @UI.lineItem: [{ position: 360, label: 'Cancelation Time' }]
    deletedtime  ;
    @UI.lineItem: [{ position: 370, label: 'Created By User' }]
    createdby  ;
    @UI.lineItem: [{ position: 380, label: 'Created By User Name' }]
    creatusername  ;
    
    
    
}